HTTP3_PORT=8443
HTTPS_PORT=8443
HTTP_PORT=8080
SERVER_NAME="https://localhost:8443, http://localhost:8080"

# Back-compat alias: older deploys that only set RAPIDAPI_PROXY_SECRET keep
# working unchanged, since GATEWAY_SECRET below falls back to it.
RAPIDAPI_PROXY_SECRET=

# Shared secret an API gateway (RapidAPI, your own reverse proxy, ...) is
# configured to send on GATEWAY_SECRET_HEADER. Every endpoint except
# /in/{inboxId} and /docs* rejects requests unless it matches. Left empty
# here (disabled) for local dev/tests and for self-hosting without a
# gateway; set a real value via .env.local.php or the deploy environment
# before going live behind a gateway.
GATEWAY_SECRET=${RAPIDAPI_PROXY_SECRET}
GATEWAY_SECRET_HEADER=X-RapidAPI-Proxy-Secret

# How long captured events are kept before `bin/console app:events:cleanup`
# deletes them. That command does nothing on its own — schedule it (e.g. a
# daily cron entry) on whatever host runs this. Inboxes themselves are never
# deleted, only their stored events, so receiving URLs keep working.
EVENT_RETENTION_DAYS=7

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###
